# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://laneline:laneline@localhost:5433/laneline?schema=public"

# Claude API key for the workout generator: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-sonnet-5-5)
# ANTHROPIC_MODEL=

# Better Auth: a random 32+ character secret (openssl rand -base64 32) and the app's URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: send magic-link emails with Resend. Without it, links print to the server console in development.
# RESEND_API_KEY=
# EMAIL_FROM="LaneLine <login@yourdomain.com>"
